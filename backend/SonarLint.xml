<?xml version="1.0" encoding="utf-8"?>
<!-- Umbrales del Anexo C del informe técnico: 500 líneas por archivo, 60 por método. -->
<AnalysisInput>
  <Rules>
    <Rule>
      <Key>S104</Key>
      <Parameters>
        <Parameter>
          <Key>maximumFileLocThreshold</Key>
          <Value>500</Value>
        </Parameter>
      </Parameters>
    </Rule>
    <Rule>
      <Key>S138</Key>
      <Parameters>
        <Parameter>
          <Key>max</Key>
          <Value>60</Value>
        </Parameter>
      </Parameters>
    </Rule>
  </Rules>
</AnalysisInput>
